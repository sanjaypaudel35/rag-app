{
    "name": "sanjay/ragbot",
    "description": "A multi-tenant RAG chatbot system for Laravel.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Sanjay",
            "email": "jaysanpaudel35@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Sanjay\\Ragbot\\": "src/",
            "Sanjay\\Ragbot\\Database\\Factories\\": "database/factories/",
            "Sanjay\\Ragbot\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sanjay\\Ragbot\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sanjay\\Ragbot\\RagbotServiceProvider"
            ]
        }
    }
}
